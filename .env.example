DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/DB_NAME

# Auth
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Time-based inventory management (food waste reduction)
QUICK_ACCESS_WINDOW_MINUTES=60
FOOD_ITEM_EXPIRY_GRACE_MINUTES=0

# Order transfer (resale of unclaimed orders)
TRANSFER_ELIGIBLE_WINDOW_MINUTES=30
ORDER_EXPIRY_GRACE_MINUTES=15

# Background maintenance job frequency
SCHEDULER_INTERVAL_SECONDS=60
